{
  "name": "jord-jd/php-base-search",
  "description": "Base interfaces/classes for searcher and search results",
  "type": "library",
  "license": "LGPL-3.0-only",
  "authors": [
    {
      "name": "Jordan Hall",
      "email": "jordan@hall05.co.uk"
    }
  ],
  "require": {
    "php": ">=7.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^7.5||^9.6||^10.5||^11.5||^12.5"
  },
  "autoload": {
    "psr-4": {
      "JordJD\\BaseSearch\\": "src/"
    }
  },
  "replace": {
    "divineomega/php-base-search": "self.version"
  },
  "extra": {
    "branch-alias": {
      "dev-master": "4.1-dev"
    }
  },
  "config": {
    "allow-plugins": {
      "kylekatarnls/update-helper": false
    }
  }
}
